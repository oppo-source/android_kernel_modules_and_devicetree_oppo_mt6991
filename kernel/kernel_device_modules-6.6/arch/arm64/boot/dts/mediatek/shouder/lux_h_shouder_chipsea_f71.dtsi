&i2c12 {
	status = "okay";
	clock-frequency = <400000>;
	csa37f71@50 {
		status = "okay";
		compatible = "chipsea,csa37f71-game";
		reg = <0x50>;
		/* Interrupt && Irq-gpio */
		interrupt-parent = <&pio>;
		interrupts = <40 0x2008>;

		/* Power Config */
		vdd_2v8-supply = <&mt6373_vio28>;

		/* Other HW Resource */
		irq-gpio = <&pio 40 0x2008>;
		reset-gpio = <&pio 130 0>;
		/*wake-gpio = <&pio 98 0>;*/

		game_mode_strength_cfg = <30 20 50 40 70 60 200 130 250 160 87 87 500 400>;
	};
};
&mt6373_vio28 {
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
	regulator-always-on;
};
