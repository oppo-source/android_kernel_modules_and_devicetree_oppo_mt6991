&panel_ae031_p_3_a0026_dsi_vdo {
	oplus,dsi-display-panel@1 {
		reg = <1>;
		oplus,dsi-vendor-name = "A0026";
		oplus,dsi-manufacture = "P_3";
		oplus,dsi-display-timings {
			timing@sa_fhd_60 {
				cell-index = <0>;
				oplus,dsi-panel-framerate = <60>;
				oplus,dsi-panel-pllclk = <648>;
