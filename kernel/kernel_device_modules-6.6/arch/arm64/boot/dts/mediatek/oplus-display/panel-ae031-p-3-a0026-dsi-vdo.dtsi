					dyn_fps_data_rate;
					oplus_dyn_fps_dfps_cmd_table0 = [00 02 2F 00];
				};
				oplus,display-mode {
					display-mode@0 {
						hdisplay = <1280>;
						vdisplay = <2800>;
						fhd-hfp = <57>;
						fhd-hsa = <4>;
						fhd-hbp = <20>;
						fhd-vfp = <116>;
						fhd-vsa = <2>;
						fhd-vbp = <26>;
						hskew = <STANDARD_ADFR>;
					};
					//display-mode@1 {
					//	hdisplay = <1080>;
					//	vdisplay = <2376>;
					//	fhd-hfp = <9>;
					//	fhd-hsa = <2>;
