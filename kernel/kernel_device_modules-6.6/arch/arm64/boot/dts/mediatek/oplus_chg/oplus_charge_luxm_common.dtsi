&i2c13 {
	status = "okay";
	clock-frequency = <400000>;
	oplus_sc8547_slave: sc8547-charger-slave@6A{
		status = "okay";
		compatible = "oplus,sc8547d";
		reg = <0x6A>;

		oplus,use_slave_cp;
		oplus_spec,irq_gpio = <&pio 61 0x00>;
		interrupt-parent = <&pio>;

		pinctrl-names = "default", "charging_inter_active", "charging_inter_sleep";
		pinctrl-0 = <&i2c13_mode_default>;
		pinctrl-1 = <&slave_charging_inter_active>;
		pinctrl-2 = <&slave_charging_inter_sleep>;

		ocp_reg = <0xe>;
		ovp_reg = <0x36>;/* vbat ovp 4.85v */
		vbus_ovp_reg = /bits/ 8 <0x5A>;  /* vbus ovp: 10.5v */
		oplus_sc8547_slave_cp: oplus,sc8547_slave_cp {
			oplus,ic_type = <OPLUS_CHG_IC_CP>;
			oplus,ic_index = <1>;
			oplus,ic_func_group = <&sc8547_cp_groups>;
		};
	};

	byb_hl7603: byb-hl7603@75 {
		status = "okay";
		compatible = "oplus,byb-hl7603";
		reg = <0x75>;
		oplus,ic_type = <OPLUS_CHG_IC_BOOST>;
		oplus,ic_index = <0>;
		oplus,vout-mv = <3950>;
		oplus,ilim-ma = <6000>;
	};

};

&i2c12 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "i2c-state", "output-low-state";
	pinctrl-0 = <&i2c12_i2c_state>;
	pinctrl-1 = <&i2c12_output_low_state>;
	sc83107-charger@69s {
		compatible = "oplus,sc83107";
		reg = <0x69>;
		status = "okay";

		oplus,sc83107,irq-gpio = <&pio 42 0x00>;
		interrupt-parent = <&pio>;
		interrupts = <42 0>;

		pinctrl-names = "boost_inter_active", "boost_inter_sleep";
		pinctrl-0 = <&boost_inter_active>;
		pinctrl-1 = <&boost_inter_sleep>;

		oplus,sc83107,operation-mode = <0>;/*0: Auto Hybrid Boost Bypass 1: Force Bypass*/
		oplus,sc83107,freq = <0>; /*0: 1MHZ 1: 700KHZ*/
		oplus,sc83107,otg-mode = <0>; /*0:disable 1:enable*/
		oplus,sc83107,wdt-timeout = <0>; /*0:disable, 1:0.5s, 2:1s, 3:2s,
							4:20s, 5:40s, 6:80s, 7:160s*/
		oplus,sc83107,vout-ovp-dis = <0>; /*0:enable 1:disable*/
		oplus,sc83107,current-limit-dis = <0>; /*0:enable 1:disable*/
		/* I2C bus reset feature control: 0=disabled (default), 1=enabled */
		oplus,sc83107,i2c-bus-reset-enable;

		oplus_sc83107_boost: oplus,sc83107_boost {
			oplus,ic_type = <OPLUS_CHG_IC_BOOST>;
			oplus,ic_index = <0>;
			oplus,ic_func_group = <&sc83107_boost_groups>;
		};
	};
};

&pio {
	i2c13_mode_default: i2c13_mode_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO163__FUNC_SCL13>,
				<PINMUX_GPIO164__FUNC_SDA13>;
			bias-pull-up = <MTK_PULL_SET_RSEL_111>;
		};
	};

	slave_charging_inter_active: slave_charging_inter_active {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO61__FUNC_GPIO61>;
			input-enable;
			bias-pull-up;
		};
	};

	slave_charging_inter_sleep: slave_charging_inter_sleep {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO61__FUNC_GPIO61>;
			input-enable;
			bias-pull-up;
		};
	};

	boost_inter_active: boost_inter_active {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO42__FUNC_GPIO42>;
			input-enable;
			bias-pull-up;
		};
	};

	boost_inter_sleep: boost_inter_sleep {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO42__FUNC_GPIO42>;
			input-enable;
			bias-pull-up;
		};
	};

	i2c12_i2c_state: i2c12_sda_i2c_state {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO161__FUNC_SCL12>,
			<PINMUX_GPIO162__FUNC_SDA12>;
			bias-pull-up;
		};
	};
	i2c12_output_low_state: i2c12_sda_output_low_state {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO161__FUNC_GPIO161>,
			<PINMUX_GPIO162__FUNC_GPIO162>;
			output-low;
		};
	};
};

//for ufcs config
&soc {
	oplus_ufcs_impedance_check: oplus,ufcs_impedance_check {
		compatible = "oplus,impedance_check";

		oplus,impedance_unit {
			oplus_ufcs_impedance_unit: oplus,ufcs_impedance_unit {
				uint_name = "ufcs";
				default_curr_ma = <7300>;
				impedance_node = <&ufcs_input_impedance>;
			};
		};
	};
};

&soc {
	oplus_cpa: oplus,cpa {
		compatible = "oplus,cpa";
		oplus,protocol_list = <CHG_PROTOCOL_UFCS 80
				       CHG_PROTOCOL_PD 18
				       CHG_PROTOCOL_VOOC 80
				       CHG_PROTOCOL_QC 18>;
		oplus,default_protocol_list = <CHG_PROTOCOL_UFCS
					       CHG_PROTOCOL_PD
					       CHG_PROTOCOL_VOOC>;
