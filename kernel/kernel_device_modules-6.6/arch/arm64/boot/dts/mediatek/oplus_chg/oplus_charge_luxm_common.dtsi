			0    250  250  250  500  500  500  500  500  0	/* OPLUS_WIRED_CHG_MODE_UNKNOWN */
			0    250  250  250  500  500  500  500  500  0	/* OPLUS_WIRED_CHG_MODE_SDP */
			0    250  250  250  500  500  500  500  500  0	/* OPLUS_WIRED_CHG_MODE_CDP */
			0    250  250  250  500  500  500  500  500  0	/* OPLUS_WIRED_CHG_MODE_DCP */
			0    250  250  250  500  500  500  500  500  0	/* OPLUS_WIRED_CHG_MODE_VOOC */
			0    250  250  250  500  500  500  500  500  0	/* OPLUS_WIRED_CHG_MODE_QC */
			0    250  250  250  500  500  500  500  500  0	/* OPLUS_WIRED_CHG_MODE_PD */
		>;
		oplus_spec,fccmax-ma-lv1 = <
		/*      <-10 <-5  <0   <5   <12  <16  <35  <45  <53  >=53 */
			0    690  690  1380 2200 2200 2200 2200 2200 0	/* OPLUS_WIRED_CHG_MODE_UNKNOWN */
			0    600  600  600  600  600  600  600  600  0	/* OPLUS_WIRED_CHG_MODE_SDP */
			0    690  690  1380 1600 1600 1600 1600 1600 0	/* OPLUS_WIRED_CHG_MODE_CDP */
			0    690  690  1380 2200 2200 2200 2200 2200 0	/* OPLUS_WIRED_CHG_MODE_DCP */
			0    690  690  1380 2200 2200 2200 2200 2200 0	/* OPLUS_WIRED_CHG_MODE_VOOC */
			0    690  690  1380 3300 3300 3300 3300 3300 0	/* OPLUS_WIRED_CHG_MODE_QC */
			0    690  690  1380 3300 3300 3300 3300 3300 0	/* OPLUS_WIRED_CHG_MODE_PD */
		>;
		oplus_spec,fccmax-ma-lv2 = <
		/*      <-10 <-5  <0   <5   <12  <16  <35  <45  <53  >=53 */
			0    363  363  690  2200 2200 2200 2200 2200 0	/* OPLUS_WIRED_CHG_MODE_UNKNOWN */
			0    363  363  600  600  600  600  600  600  0	/* OPLUS_WIRED_CHG_MODE_SDP */
			0    363  363  690  1600 1600 1600 1600 1600 0	/* OPLUS_WIRED_CHG_MODE_CDP */
			0    363  363  690  2200 2200 2200 2200 2200 0	/* OPLUS_WIRED_CHG_MODE_DCP */
			0    363  363  690  2200 2200 2200 2200 2200 0	/* OPLUS_WIRED_CHG_MODE_VOOC */
			0    363  363  690  2277 2415 3300 3300 3300 0	/* OPLUS_WIRED_CHG_MODE_QC */
			0    363  363  690  2277 2415 3300 3300 3300 0	/* OPLUS_WIRED_CHG_MODE_PD */
		>;
		oplus_spec,fccmax-ma-hv = <
		/*      <-10 <-5  <0   <5   <12  <16  <35  <45  <53  >=53 */
			0    363  363  690  1035 1380 2070 2200 1000 0	/* OPLUS_WIRED_CHG_MODE_UNKNOWN */
			0    363  363  600  600  600  600  600  600  0	/* OPLUS_WIRED_CHG_MODE_SDP */
			0    363  363  690  1035 1380 1600 1600 1600 0	/* OPLUS_WIRED_CHG_MODE_CDP */
			0    363  363  690  1035 1380 2070 2200 2200 0	/* OPLUS_WIRED_CHG_MODE_DCP */
			0    363  363  690  1035 1380 2070 2200 2200 0	/* OPLUS_WIRED_CHG_MODE_VOOC */
			0    363  363  690  1035 1380 2070 3300 3300 0	/* OPLUS_WIRED_CHG_MODE_QC */
			0    363  363  690  1035 1380 2070 3300 3300 0	/* OPLUS_WIRED_CHG_MODE_PD */
