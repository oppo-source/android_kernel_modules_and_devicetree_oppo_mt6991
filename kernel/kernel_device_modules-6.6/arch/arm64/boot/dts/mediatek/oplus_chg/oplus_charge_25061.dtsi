};

&charger {
	io-channels = <&mt6373_adc AUXADC_VIN1>,  <&mt6373_adc AUXADC_VIN2>,
			<&pmic_adc (ADC_PURES_100K_MASK | AUXADC_VIN2)>,
			<&pmic_adc (ADC_PURES_100K_MASK | AUXADC_VIN1)>,
			<&pmic_adc (ADC_PURES_100K_MASK | AUXADC_VIN2)>,
			<&pmic_adc (ADC_PURES_100K_MASK | AUXADC_VIN6)>,
			<&mt6379_adc MT6379_ADC_VBAT>;
	io-channel-names = "slave_cp_temp",
			   "sub_bat_btb_temp",
			   "master_cp_temp",
			   "auxadc1-ntc_sub_bat_tem",
			   "auxadc5_batt_btb_temp", "auxadc6_usb_btb_temp",
			   "vbat_pwr_vol";

	pinctrl-names = "default";
	pinctrl-0 = <&charger_pins_default>;
	oplus,support_ntc_01c_precision;
	oplus,support_subboard_ntc;
	max_charger_voltage = <15000000>;
	oplus,usb_aicl_enhance;
	/* ntc_resistance:100k internal_pull_up:100k voltage:1.84v */
	oplus,ntc_temp_volt_1840mv;
	oplus,low_batt_otg_boost_curr_ua = <500000>;
	oplus,ic_type = <OPLUS_CHG_IC_BUCK>;
	oplus,ic_index = <0>;

	oplus_mt6991_gauge: oplus,mt6991_gauge {
		oplus,ic_type = <OPLUS_CHG_IC_GAUGE>;
		oplus,ic_index = <1>;
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;

	oplus_ext_gauge: bq27541-battery@55 {
		status = "okay";
		compatible = "oplus,bq27541-battery";
		reg = <0x55 0>;
		qcom,modify-soc-smooth;
		qcom,modify-soc-calibration;
		qcom,sha1_key_index = <1>;
		oplus,batt_num = <1>;
		oplus,ic_type = <OPLUS_CHG_IC_GAUGE>;
		oplus,ic_index = <0>;
		oplus,support_extern_cmd;
		oplus,calib_info_save_support;
		oplus,batt_nfg8011b;
	};
};

&soc {
	prechg_param:prechg_param {
		sdp_type {
			oplus,chg-type = <OPLUS_PRECHG_TYPE_SDP>;
			oplus,input-current-ma = <500>;
			oplus,temp-boundary-degc = <(-10) (-5) 0 5 12 16 35 45 53>;
			oplus,temp-hyst-degc = <2>;
			oplus,ichg-ma = <
				/*           <-10 <-5 <0   <5   <12  <16  <35  <45  <53  >=53 */
				/* stage0 */ 0    250 250  250  250  250  250  250  250  0
				/* stage1 */ 0    250 250  250  500  500  500  500  500  0
				/* stage2 */ 0    600 600  600  600  600  600  600  600  0
				/* stage3 */ 0    388 388  600  600  600  600  600  600  0
				/* stage4 */ 0    388 388  600  600  600  600  600  600  0
			>;
			oplus,stage-thd-mv = <
				/*                <-10 <-5  <0   <5   <12  <16  <35  <45  <53  >=53 */
				/* stage0 high */ 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500
				/* stage1 high */ 2750 2750 2750 2750 2750 2750 2750 2750 2750 2750
				/* stage2 high */ 3980 3980 3980 4080 4080 4080 4080 4250 4080 4080
				/* stage3 high */ 4180 4180 4180 4180 4230 4230 4180 4380 4180 4180
			>;
			oplus,pre2fast-thd-mv = <
				/*           <-10 <-5  <0   <5   <12  <16  <35  <45  <53  >=53 */
				/* stage0 */ 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200
				/* stage1 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage2 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage3 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage4 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
			>;
		};
		cdp_type {
			oplus,chg-type = <OPLUS_PRECHG_TYPE_CDP>;
			oplus,input-current-ma = <1500>;
			oplus,temp-boundary-degc = <(-10) (-5) 0 5 12 16 35 45 53>;
			oplus,temp-hyst-degc = <2>;
			oplus,ichg-ma = <
				/*           <-10 <-5 <0   <5   <12  <16  <35  <45  <53  >=53 */
				/* stage0 */ 0    250 250  250  250  250  250  250  250  0
				/* stage1 */ 0    250 250  250  500  500  500  500  500  0
				/* stage2 */ 0    737 737  1552 1600 1600 1600 1600 1600 0
				/* stage3 */ 0    388 388  737  1600 1600 1600 1600 1600 0
				/* stage4 */ 0    388 388  737  1474 1600 1600 1600 1600 0
			>;
			oplus,stage-thd-mv = <
				/*                <-10 <-5  <0   <5   <12  <16  <35  <45  <53  >=53 */
				/* stage0 high */ 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500
				/* stage1 high */ 2750 2750 2750 2750 2750 2750 2750 2750 2750 2750
				/* stage2 high */ 3980 3980 3980 4080 4080 4080 4080 4250 4080 4080
				/* stage3 high */ 4180 4180 4180 4180 4230 4230 4180 4380 4180 4180
			>;
			oplus,pre2fast-thd-mv = <
				/*           <-10 <-5  <0   <5   <12  <16  <35  <45  <53  >=53 */
				/* stage0 */ 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200
				/* stage1 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage2 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage3 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage4 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
			>;
		};
		dcp_type {
			oplus,chg-type = <OPLUS_PRECHG_TYPE_DCP>;
			oplus,input-current-ma = <2000>;
			oplus,temp-boundary-degc = <(-10) (-5) 0 5 12 16 35 45 53>;
			oplus,temp-hyst-degc = <2>;
			oplus,ichg-ma = <
				/*           <-10 <-5 <0   <5   <12  <16  <35  <45  <53  >=53 */
				/* stage0 */ 0    250 250  250  250  250  250  250  250  0
				/* stage1 */ 0    250 250  250  500  500  500  500  500  0
				/* stage2 */ 0    737 737  1552 2200 2200 2200 2200 2200 0
				/* stage3 */ 0    388 388  737  2200 2200 2200 2200 2200 0
				/* stage4 */ 0    388 388  737  1474 2200 2200 2200 2200 0
			>;
			oplus,stage-thd-mv = <
				/*               <-10  <-5  <0   <5   <12  <16  <35  <45  <53  >=53 */
				/* stage0 high */ 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500
				/* stage1 high */ 2750 2750 2750 2750 2750 2750 2750 2750 2750 2750
				/* stage2 high */ 3980 3980 3980 4080 4080 4080 4080 4250 4080 4080
				/* stage3 high */ 4180 4180 4180 4180 4230 4230 4180 4380 4180 4180
			>;
			oplus,pre2fast-thd-mv = <
				/*           <-10 <-5  <0   <5   <12  <16  <35  <45  <53  >=53 */
				/* stage0 */ 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200
				/* stage1 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage2 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage3 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage4 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
			>;
		};
		invalid_type {
			oplus,chg-type = <OPLUS_PRECHG_TYPE_INVALID>;
			oplus,input-current-ma = <500>;
			oplus,temp-boundary-degc = <(-10) (-5) 0 5 12 16 35 45 53>;
			oplus,temp-hyst-degc = <2>;
			oplus,ichg-ma = <
				/*           <-10 <-5 <0   <5   <12  <16  <35  <45  <53  >=53 */
				/* stage0 */ 0    250 250  250  250  250  250  250  250  0
				/* stage1 */ 0    250 250  250  500  500  500  500  500  0
				/* stage2 */ 0    600 600  600  600  600  600  600  600  0
				/* stage3 */ 0    388 388  600  600  600  600  600  600  0
				/* stage4 */ 0    388 388  600  600  600  600  600  600  0
			>;
			oplus,stage-thd-mv = <
				/*               <-10  <-5  <0   <5   <12  <16  <35  <45  <53  >=53 */
				/* stage0 high */ 2500 2500 2500 2500 2500 2500 2500 2500 2500 2500
				/* stage1 high */ 2750 2750 2750 2750 2750 2750 2750 2750 2750 2750
				/* stage2 high */ 3980 3980 3980 4080 4080 4080 4080 4250 4080 4080
				/* stage3 high */ 4180 4180 4180 4180 4230 4230 4180 4380 4180 4180
			>;
			oplus,pre2fast-thd-mv = <
				/*           <-10 <-5  <0   <5   <12  <16  <35  <45  <53  >=53 */
				/* stage0 */ 3200 3200 3200 3200 3200 3200 3200 3200 3200 3200
				/* stage1 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage2 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage3 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
				/* stage4 */ 2600 2600 2600 2600 2600 2600 2600 2600 2600 2600
			>;
		};
	};
};

&mt6379_chg {
	support_icl_optimization;
};

&lk_charger {
	is_support_mt6379;
	single_batt_external_gauge_support;
	support_tuv_authentication;
	support_sdp_screenoff;
	sdp_screenon_voltage = <3250>;
	use_extern_gauge;
	support_quickboot_charge;
	support_icl_optimization;
	sub_board_temp_support;
	sub_board_adc_channel = <18>; /* AUXADC_VIN1 */
	sub_board_adc_pull_up_voltage = <1840>;
	sub_board_adc_pures = <0>;	/* config as SDMADC_100K */
	over_high_temp_thr = <60>;
	support_battery_type = <7>;
	set_plat_vsysmin = <3400>;
	support_chg_time_cnt;
	support_chg_time_r;
	support_chg_track_r;

	oplus,batt_info = /bits/ 8 <0x36 0x31 0x31 0x33 0x30 0x33 0x30 0x30 0x30 0x33 0x35 0x30
				    0x36 0x31 0x31 0x33 0x30 0x33 0x30 0x30 0x30 0x33 0x35 0x31>;
	oplus,batt_resource_info = /bits/ 8 <0 1>;

	/* mt6991 start */
	led-brightness = <102>;
	/* mt6991, such as max_charger_voltage to max-charger-voltage */
	gauge-i2c-id = <0x00>;
	max-charger-voltage = <15000000>;
	boot-battery-voltage = <2950000>;
	usb-charger-current = <500000>;
	ac-charger-current = <2050000>;
	ac-charger-input-current = <1500000>;
	non-std-ac-charger-current = <750000>;
	charging-host-charger-current = <1500000>;
	ta-ac-charger-current = <1500000>;
	pd-charger-current = <500000>;
	/* mt6991 end */

	/* sc83107 start*/
	support_boost_sc83107;
	sc83107_i2c_id = <3>;
	sc83107_irq_gpio = <216>;
	/* sc83107 end*/

	/* for silicon battery */
	is_silicon_battery;
	max-term-voltage-mv = <3260>;
	min-term-voltage-mv = <2750>;
	dcp-boot-thd-inc-mv = <(-300)>;
	cdp-boot-thd-inc-mv = <(50)>;
	sdp-boot-thd-inc-mv = <(50)>;
	nochg-boot-thd-inc-mv = <(50)>;
	max-boot-thd-mv = <(3360)>;
	min-boot-thd-mv = <(2950)>;
	dcp-max-boot-thd-mv = <(3310)>;
	dcp-min-boot-thd-mv = <(2850)>;
	prechg1-thd-mv = <2900>;
	prechg1-current-ma = <250>;
	temp-low-inc1 = <500>; /* < -20 */
	temp-low-inc2 = <500>; /* -20 ~ -10 */
	temp-low-inc3 = <500>; /* -10 ~ 0 */
	temp-low-inc4 = <100>; /* 0 ~ 20 */
	temp-low-inc5 = <0>; /* > 20 */
	/* silicon battery end */
	prechg_param = <&prechg_param>;
};

&i2c0 {
	pinctrl-names = "i2c-state", "output-low-state", "default";
	pinctrl-0 = <&i2c0_i2c_state>;
	pinctrl-1 = <&i2c0_output_low_state>;
	pinctrl-2 = <&i2c0_i2c_mode_config>;
};
&pio {
	i2c0_i2c_state: i2c0_sda_i2c_state {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO99__FUNC_SCL0>,
			<PINMUX_GPIO100__FUNC_SDA0>;
			bias-pull-up = <MTK_PULL_SET_RSEL_010>;
		};
	};
	i2c0_output_low_state: i2c0_sda_output_low_state {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO99__FUNC_GPIO99>,
			<PINMUX_GPIO100__FUNC_GPIO100>;
			output-low;
		};
	};
	i2c0_i2c_mode_config: i2c0_i2c_mode_config {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO99__FUNC_SCL0>,
			<PINMUX_GPIO100__FUNC_SDA0>;
			bias-pull-up = <MTK_PULL_SET_RSEL_010>;
			input-enable;
		};
	};
};

&soc {
	oplus_mms_wired: oplus,mms_wired {
		compatible = "oplus,mms_wired";
		oplus,buck_ic = <&oplus_virtual_buck>;
		oplus,voocphy_ic = <&oplus_virtual_vphy>;

		oplus,adc_info_name = "100k_1840mv";
		oplus_spec,usbtemp_batttemp_gap = <12>;
		high-temp-scheme;
		oplus,support_adjust_reverse_chg_cur;

		/* support for V2.0 usbtemp protect. */
		oplus,support_usbtemp_protect_v2;
		oplus_spec,usbtemp_batt_temp_low = <50>;
		oplus_spec,usbtemp_batt_temp_high = <50>;
		oplus_spec,usbtemp_batt_temp_over_hot = <60>;
		oplus_spec,usbtemp_ntc_temp_low = <57>;
		oplus_spec,usbtemp_ntc_temp_high = <69>;
		oplus_spec,usbtemp_temp_gap_low_with_batt_temp = <7>;
		oplus_spec,usbtemp_temp_gap_high_with_batt_temp = <12>;
		oplus_spec,usbtemp_temp_gap_with_batt_temp_in_over_hot = <15>;
		oplus_spec,usbtemp_temp_gap_low_without_batt_temp = <12>;
		oplus_spec,usbtemp_temp_gap_high_without_batt_temp = <24>;
		oplus_spec.usbtemp_rise_fast_temp_low = <3>;
		oplus_spec.usbtemp_rise_fast_temp_high = <3>;
		oplus_spec.usbtemp_rise_fast_temp_count_low = <30>;
		oplus_spec.usbtemp_rise_fast_temp_count_high = <20>;
		oplus_spec,usbtemp_cool_down_ntc_low = <54>;
		oplus_spec,usbtemp_cool_down_ntc_high = <65>;
		oplus_spec,usbtemp_cool_down_gap_low = <12>;
		oplus_spec,usbtemp_cool_down_gap_high = <20>;
		oplus_spec,usbtemp_cool_down_recover_ntc_low = <48>;
		oplus_spec,usbtemp_cool_down_recover_ntc_high = <60>;
		oplus_spec,usbtemp_cool_down_recover_gap_low = <6>;
		oplus_spec,usbtemp_cool_down_recover_gap_high = <15>;
		oplus_spec,otg_output = <2100000 3900
					1800000 3500
					1300000 2700>;

		oplus_virtual_buck: oplus,virtual_buck {
			compatible = "oplus,virtual_buck";
			oplus,buck_ic = <&charger &byb_hl7603>;
			oplus,buck_ic_index = <0 1>;
			oplus,buck_ic_current_ratio = <100 0>;
			oplus,buck_ic_connect = <OPLUS_CHG_IC_CONNECT_PARALLEL>;
			oplus,main_charger = <0>;
			oplus,buck_ic_func_group = <&mtk_6991_groups &byb_hl7603_groups>;

			oplus,ic_type = <OPLUS_CHG_IC_VIRTUAL_BUCK>;
			oplus,ic_index = <0>;

			io-channels = <&mt6373_adc AUXADC_VIN4>, <&mt6373_adc AUXADC_VIN5>;
			io-channel-names = "usb_temp_adc_l", "usb_temp_adc_r";

			oplus,uart_tx-gpio = <&pio 160 0x00>;
			oplus,uart_rx-gpio = <&pio 161 0x00>;
		};
	};

	oplus_mms_gauge: oplus,mms_gauge {
		compatible = "oplus,mms_gauge";
		oplus,gauge_ic = <&oplus_virtual_gauge>;
		oplus,topic-update-interval = <5000>;
		oplus,support_subboard_ntc;
		oplus,sub_btb_curr_limit = <3000>; /* Online current limiting, provided by hardware engineer */
		oplus,fcl_support;
		oplus,fcl_index = <0>;
		oplus,vb_offset = <20>;

		deep_spec,support;
		deep_spec,soc_boost_term_voltage_offset_mv = <0>;
		deep_spec,uv_thr = <2750>;
		deep_spec,count_thr = <50>;
		deep_spec,vbat_soc = <80>;
		deep_spec,count_step = <0 10 0
					350 12 1
					450 15 2
					530 20 3>;
		deep_spec,term_coeff = <2750 450 2
					2800 500 2
					2900 500 2
					3000 600 4
					3010 600 4
					3050 700 6
					3100 750 8
					3110 750 8
					3150 850 10
					3160 850 10
					3200 950 12
					3210 950 12
					3260 1050 12>;
		deep_spec,ddrc_strategy_name = "ddrc_curve_v2";
		deep_spec,volt_step = <20>;
		deep_spec,ddbc_curve {
			oplus,temp_type = <OPLUS_STRATEGY_USE_BATT_TEMP>;
			oplus,temp_range = <(-100) 0 200>;
			deep_spec,ddbc_temp_cold = <500 3250 5
						   10000 3200 2>;
			deep_spec,ddbc_temp_cool = <500 3250 5
						   10000 3200 2>;
			deep_spec,ddbc_temp_normal = <500 3250 5
