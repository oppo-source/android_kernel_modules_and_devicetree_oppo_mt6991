					OPLUS_IC_FUNC_BOOST_SET_BCL_VOL
					OPLUS_IC_FUNC_BOOST_GET_IN_CV_MODE
					OPLUS_IC_FUNC_BOOST_GET_CV
					OPLUS_IC_FUNC_BOOST_IS_SUSPEND
